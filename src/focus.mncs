mncs 0.8;

// Focus and dispatch consume the same WidgetTree used by hit-testing. The
// tree owns clipping and z-order; callers never supply a parallel coordinate
// list that could disagree with rendering.
module mncs_tui.focus;

use mncs.core.geometry.v1;
use mncs_tui.widgets;
use mncs_tui.events;

record FocusState { current: WidgetId, count: i64, valid: bool }
record HitTestResult { hit_id: WidgetId, hit: bool }
record DispatchResult { consumed: bool, new_focus: WidgetId, damage: bool }

fn invalid_id() -> (result: WidgetId) {
    return WidgetId { value: 0 - 1 };
}

fn focus_init(tree: WidgetTree) -> (result: FocusState) {
    let first: WidgetId = first_focusable(tree);
    return FocusState { current: first, count: select(first.value >= 0, 1, 0), valid: first.value >= 0 };
}

fn focus_is_valid(state: FocusState) -> (result: bool) {
    return state.valid && state.current.value >= 0;
}

fn focus_move_next(state: FocusState, tree: WidgetTree) -> (result: FocusState) {
    let next_id: WidgetId = next_focusable(state.current, tree);
    if next_id.value < 0 {
        return state;
    }
    return FocusState { current: next_id, count: state.count +% 1, valid: true };
}

fn previous_before(current: WidgetId, tree: WidgetTree) -> (result: WidgetId) {
    if widget_id_equal(current, tree.fourth.id) {
        if widget_is_focusable(tree.third) { return tree.third.id; }
        if widget_is_focusable(tree.second) { return tree.second.id; }
        if widget_is_focusable(tree.first) { return tree.first.id; }
        return invalid_id();
    }
    if widget_id_equal(current, tree.third.id) {
        if widget_is_focusable(tree.second) { return tree.second.id; }
        if widget_is_focusable(tree.first) { return tree.first.id; }
        return invalid_id();
    }
    if widget_id_equal(current, tree.second.id) {
        if widget_is_focusable(tree.first) { return tree.first.id; }
        return invalid_id();
    }
    return invalid_id();
}

fn last_focusable(tree: WidgetTree) -> (result: WidgetId) {
    if widget_is_focusable(tree.fourth) { return tree.fourth.id; }
    if widget_is_focusable(tree.third) { return tree.third.id; }
    if widget_is_focusable(tree.second) { return tree.second.id; }
    if widget_is_focusable(tree.first) { return tree.first.id; }
    return invalid_id();
}

fn focus_move_prev(state: FocusState, tree: WidgetTree) -> (result: FocusState) {
    let candidate: WidgetId = previous_before(state.current, tree);
    if candidate.value >= 0 {
        return FocusState { current: candidate, count: state.count +% 1, valid: true };
    }
    let wrapped: WidgetId = last_focusable(tree);
    return FocusState { current: wrapped, count: state.count +% 1, valid: wrapped.value >= 0 };
}

fn focus_contains(state: FocusState, widget: Widget) -> (result: bool) {
    return widget_id_equal(state.current, widget.id);
}

fn hit_test_point(point: Point, tree: WidgetTree) -> (result: HitTestResult) {
    let id: i64 = tree_contains(tree, point);
    return HitTestResult { hit_id: WidgetId { value: id }, hit: id >= 0 };
}

fn hit_test_mouse(mouse: MouseEvent, tree: WidgetTree) -> (result: HitTestResult) {
    if mouse.valid {
        return hit_test_point(Point { column: mouse.column, row: mouse.row }, tree);
    }
    return HitTestResult { hit_id: invalid_id(), hit: false };
}

fn tree_widget(tree: WidgetTree, id: WidgetId) -> (result: Widget) {
    if widget_id_equal(id, tree.first.id) { return tree.first; }
    if widget_id_equal(id, tree.second.id) { return tree.second; }
    if widget_id_equal(id, tree.third.id) { return tree.third; }
    if widget_id_equal(id, tree.fourth.id) { return tree.fourth; }
    return tree.root;
}

fn dispatch_key(key: KeyEvent, focus: FocusState, tree: WidgetTree) -> (result: DispatchResult) {
    if key.valid {
        let is_tab: bool = match key.kind {
            TAB => true,
            CHAR => false,
            ENTER => false,
            BACKSPACE => false,
            ESC => false,
            ARROW_UP => false,
            ARROW_DOWN => false,
            ARROW_LEFT => false,
            ARROW_RIGHT => false,
            UNKNOWN => false,
        };
        if is_tab {
            let next_state: FocusState = focus_move_next(focus, tree);
            return DispatchResult { consumed: true, new_focus: next_state.current, damage: true };
        }
        let is_enter: bool = match key.kind {
            ENTER => true,
            CHAR => false,
            BACKSPACE => false,
            ESC => false,
            ARROW_UP => false,
            ARROW_DOWN => false,
            ARROW_LEFT => false,
            ARROW_RIGHT => false,
            TAB => false,
            UNKNOWN => false,
        };
        if is_enter && focus.valid {
            return DispatchResult { consumed: true, new_focus: focus.current, damage: true };
        }
    }
    return DispatchResult { consumed: false, new_focus: focus.current, damage: false };
}

fn dispatch_mouse(mouse: MouseEvent, focus: FocusState, tree: WidgetTree) -> (result: DispatchResult) {
    let hit: HitTestResult = hit_test_mouse(mouse, tree);
    if hit.hit {
        let target: Widget = tree_widget(tree, hit.hit_id);
        if widget_is_focusable(target) {
            return DispatchResult { consumed: true, new_focus: hit.hit_id, damage: true };
        }
        return DispatchResult { consumed: true, new_focus: focus.current, damage: false };
    }
    return DispatchResult { consumed: false, new_focus: focus.current, damage: false };
}

fn dispatch_resize(new_size: Size, old_size: Size) -> (result: bool) {
    return new_size.columns != old_size.columns || new_size.rows != old_size.rows;
}

fn dispatch_event(event: Event, focus: FocusState, tree: WidgetTree) -> (result: DispatchResult) {
    return match event {
        Key { key } => dispatch_key(key, focus, tree),
        Mouse { mouse } => dispatch_mouse(mouse, focus, tree),
        Resize { size } => DispatchResult { consumed: true, new_focus: focus.current, damage: true },
        PasteStart => DispatchResult { consumed: false, new_focus: focus.current, damage: false },
        PasteEnd => DispatchResult { consumed: false, new_focus: focus.current, damage: false },
        Paste { length } => DispatchResult { consumed: false, new_focus: focus.current, damage: false },
        Focus { gained } => DispatchResult { consumed: false, new_focus: focus.current, damage: gained },
        Quit => DispatchResult { consumed: true, new_focus: focus.current, damage: false },
        Unknown { raw } => DispatchResult { consumed: false, new_focus: focus.current, damage: false },
    };
}

fn needs_relayout(old_size: Size, new_size: Size) -> (result: bool) {
    return dispatch_resize(new_size, old_size);
}
