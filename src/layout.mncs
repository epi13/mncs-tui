mncs 0.8;

// Constraint-based layout solver for TUI geometry.
// Bounded, deterministic, total, and evidence-honest.

module mncs_tui.layout;

use mncs.core.geometry.v1;
use mncs_tui.geometry;

enum Axis { HORIZONTAL, VERTICAL }
enum Sizing { FIXED, INTRINSIC, GROW }

record Constraint { minimum: i64, maximum: i64, desired: i64, sizing: i64, weight: i64 }
record RowWidths { w0: i64, w1: i64, w2: i64, w3: i64 }
record ColumnHeights { h0: i64, h1: i64, h2: i64, h3: i64 }
record DemoLayout { window: Rect, header: Rect, body: Rect, nav: Rect, main_panel: Rect, status: Rect }
record RowSolveResult { widths: RowWidths, overflow: bool, needed: i64, allocated: i64 }
record ColumnSolveResult { heights: ColumnHeights, overflow: bool, needed: i64, allocated: i64 }

fn clamp_desired(cons: Constraint) -> (result: i64) {
    let d: i64 = cons.desired;
    let lo: i64 = cons.minimum;
    let hi: i64 = cons.maximum;
    if d < lo {
        return lo;
    }
    if d > hi {
        return hi;
    }
    return d;
}

fn is_grow(cons: Constraint) -> (result: bool) {
    return cons.sizing == 2;
}

fn is_fixed_like(cons: Constraint) -> (result: bool) {
    return cons.sizing != 2;
}

fn fixed_width(cons: Constraint) -> (result: i64) {
    if is_fixed_like(cons) {
        return clamp_desired(cons);
    }
    return 0;
}

fn grow_min(cons: Constraint) -> (result: i64) {
    if is_grow(cons) {
        return cons.minimum;
    }
    return 0;
}

fn count_grow4(ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: i64) {
    return select(is_grow(ca), 1, 0) +% select(is_grow(cb), 1, 0) +% select(is_grow(cc), 1, 0) +% select(is_grow(cd), 1, 0);
}

fn sum_fixed4(ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: i64) {
    return fixed_width(ca) +% fixed_width(cb) +% fixed_width(cc) +% fixed_width(cd);
}

fn sum_mins4(ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: i64) {
    return ca.minimum +% cb.minimum +% cc.minimum +% cd.minimum;
}

fn sum_grow_mins4(ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: i64) {
    return grow_min(ca) +% grow_min(cb) +% grow_min(cc) +% grow_min(cd);
}

fn constraint_total_weight4(ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: i64) {
    return select(is_grow(ca), ca.weight, 0) +% select(is_grow(cb), cb.weight, 0) +% select(is_grow(cc), cc.weight, 0) +% select(is_grow(cd), cd.weight, 0);
}

fn solve_widths4_checked(available: i64, ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: RowSolveResult) {
    let sum_mins: i64 = ca.minimum +% cb.minimum +% cc.minimum +% cd.minimum;
    let sum_fixed: i64 = fixed_width(ca) +% fixed_width(cb) +% fixed_width(cc) +% fixed_width(cd);
    let sum_grow_mins: i64 = grow_min(ca) +% grow_min(cb) +% grow_min(cc) +% grow_min(cd);
    let avail: i64 = select(available < 0, 0, available);
    if sum_mins > avail {
        let widths: RowWidths = RowWidths { w0: ca.minimum, w1: cb.minimum, w2: cc.minimum, w3: cd.minimum };
        let allocated: i64 = ca.minimum +% cb.minimum +% cc.minimum +% cd.minimum;
        return RowSolveResult { widths: widths, overflow: true, needed: sum_mins -% avail, allocated: allocated };
    }
    let remaining: i64 = avail -% sum_fixed -% sum_grow_mins;
    let clamped_remain: i64 = select(remaining < 0, 0, remaining);
    let grow_count: i64 = select(is_grow(ca), 1, 0) +% select(is_grow(cb), 1, 0) +% select(is_grow(cc), 1, 0) +% select(is_grow(cd), 1, 0);
    let per: i64 = select(grow_count == 0, 0, clamped_remain / grow_count);
    let w0: i64 = select(is_grow(ca), ca.minimum +% per, fixed_width(ca));
    let w0b: i64 = select(w0 < ca.minimum, ca.minimum, select(w0 > ca.maximum, ca.maximum, w0));
    let w1: i64 = select(is_grow(cb), cb.minimum +% per, fixed_width(cb));
    let w1b: i64 = select(w1 < cb.minimum, cb.minimum, select(w1 > cb.maximum, cb.maximum, w1));
    let w2: i64 = select(is_grow(cc), cc.minimum +% per, fixed_width(cc));
    let w2b: i64 = select(w2 < cc.minimum, cc.minimum, select(w2 > cc.maximum, cc.maximum, w2));
    let w3: i64 = select(is_grow(cd), cd.minimum +% per, fixed_width(cd));
    let w3b: i64 = select(w3 < cd.minimum, cd.minimum, select(w3 > cd.maximum, cd.maximum, w3));
    let widths: RowWidths = RowWidths { w0: w0b, w1: w1b, w2: w2b, w3: w3b };
    let allocated: i64 = w0b +% w1b +% w2b +% w3b;
    return RowSolveResult { widths: widths, overflow: false, needed: 0, allocated: allocated };
}

fn solve_widths4(available: i64, ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: RowWidths) {
    let res: RowSolveResult = solve_widths4_checked(available, ca, cb, cc, cd);
    return res.widths;
}

fn solve_heights4_checked(available: i64, ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: ColumnSolveResult) {
    let sum_mins: i64 = ca.minimum +% cb.minimum +% cc.minimum +% cd.minimum;
    let sum_fixed: i64 = fixed_width(ca) +% fixed_width(cb) +% fixed_width(cc) +% fixed_width(cd);
    let sum_grow_mins: i64 = grow_min(ca) +% grow_min(cb) +% grow_min(cc) +% grow_min(cd);
    let avail: i64 = select(available < 0, 0, available);
    if sum_mins > avail {
        let heights: ColumnHeights = ColumnHeights { h0: ca.minimum, h1: cb.minimum, h2: cc.minimum, h3: cd.minimum };
        let allocated: i64 = ca.minimum +% cb.minimum +% cc.minimum +% cd.minimum;
        return ColumnSolveResult { heights: heights, overflow: true, needed: sum_mins -% avail, allocated: allocated };
    }
    let remaining: i64 = avail -% sum_fixed -% sum_grow_mins;
    let clamped_remain: i64 = select(remaining < 0, 0, remaining);
    let grow_count: i64 = select(is_grow(ca), 1, 0) +% select(is_grow(cb), 1, 0) +% select(is_grow(cc), 1, 0) +% select(is_grow(cd), 1, 0);
    let per: i64 = select(grow_count == 0, 0, clamped_remain / grow_count);
    let h0: i64 = select(is_grow(ca), ca.minimum +% per, fixed_width(ca));
    let h0b: i64 = select(h0 < ca.minimum, ca.minimum, select(h0 > ca.maximum, ca.maximum, h0));
    let h1: i64 = select(is_grow(cb), cb.minimum +% per, fixed_width(cb));
    let h1b: i64 = select(h1 < cb.minimum, cb.minimum, select(h1 > cb.maximum, cb.maximum, h1));
    let h2: i64 = select(is_grow(cc), cc.minimum +% per, fixed_width(cc));
    let h2b: i64 = select(h2 < cc.minimum, cc.minimum, select(h2 > cc.maximum, cc.maximum, h2));
    let h3: i64 = select(is_grow(cd), cd.minimum +% per, fixed_width(cd));
    let h3b: i64 = select(h3 < cd.minimum, cd.minimum, select(h3 > cd.maximum, cd.maximum, h3));
    let heights: ColumnHeights = ColumnHeights { h0: h0b, h1: h1b, h2: h2b, h3: h3b };
    let allocated: i64 = h0b +% h1b +% h2b +% h3b;
    return ColumnSolveResult { heights: heights, overflow: false, needed: 0, allocated: allocated };
}

fn solve_heights4(available: i64, ca: Constraint, cb: Constraint, cc: Constraint, cd: Constraint) -> (result: ColumnHeights) {
    let res: ColumnSolveResult = solve_heights4_checked(available, ca, cb, cc, cd);
    return res.heights;
}

fn place_row(parent: Rect, widths: RowWidths) -> (result: RowRects) {
    let x0: i64 = parent.origin.column;
    let y: i64 = parent.origin.row;
    let h: i64 = parent.size.rows;
    let r0: Rect = Rect { origin: Point { column: x0, row: y }, size: Size { columns: widths.w0, rows: h } };
    let x1: i64 = x0 +% widths.w0;
    let r1: Rect = Rect { origin: Point { column: x1, row: y }, size: Size { columns: widths.w1, rows: h } };
    let x2: i64 = x1 +% widths.w1;
    let r2: Rect = Rect { origin: Point { column: x2, row: y }, size: Size { columns: widths.w2, rows: h } };
    let x3: i64 = x2 +% widths.w2;
    let r3: Rect = Rect { origin: Point { column: x3, row: y }, size: Size { columns: widths.w3, rows: h } };
    return RowRects { r0: r0, r1: r1, r2: r2, r3: r3 };
}

record RowRects { r0: Rect, r1: Rect, r2: Rect, r3: Rect }

fn place_column(parent: Rect, heights: ColumnHeights) -> (result: ColumnRects) {
    let x: i64 = parent.origin.column;
    let y0: i64 = parent.origin.row;
    let w: i64 = parent.size.columns;
    let r0: Rect = Rect { origin: Point { column: x, row: y0 }, size: Size { columns: w, rows: heights.h0 } };
    let y1: i64 = y0 +% heights.h0;
    let r1: Rect = Rect { origin: Point { column: x, row: y1 }, size: Size { columns: w, rows: heights.h1 } };
    let y2: i64 = y1 +% heights.h1;
    let r2: Rect = Rect { origin: Point { column: x, row: y2 }, size: Size { columns: w, rows: heights.h2 } };
    let y3: i64 = y2 +% heights.h2;
    let r3: Rect = Rect { origin: Point { column: x, row: y3 }, size: Size { columns: w, rows: heights.h3 } };
    return ColumnRects { r0: r0, r1: r1, r2: r2, r3: r3 };
}

record ColumnRects { r0: Rect, r1: Rect, r2: Rect, r3: Rect }

fn make_fixed(size: i64) -> (result: Constraint) {
    return Constraint { minimum: size, maximum: size, desired: size, sizing: 0, weight: 0 };
}

fn make_grow(lo: i64, hi: i64) -> (result: Constraint) {
    return Constraint { minimum: lo, maximum: hi, desired: 0, sizing: 2, weight: 1 };
}

fn make_grow_weighted(lo: i64, hi: i64, weight: i64) -> (result: Constraint) {
    return Constraint { minimum: lo, maximum: hi, desired: 0, sizing: 2, weight: weight };
}

fn make_intrinsic(desired: i64, lo: i64, hi: i64) -> (result: Constraint) {
    return Constraint { minimum: lo, maximum: hi, desired: desired, sizing: 1, weight: 0 };
}

fn demo_layout(terminal: Size) -> (result: DemoLayout) {
    let window: Rect = Rect { origin: Point { column: 0, row: 0 }, size: terminal };
    let header: Rect = Rect { origin: Point { column: 0, row: 0 }, size: Size { columns: terminal.columns, rows: 3 } };
    let body_h: i64 = terminal.rows -% 4;
    let body_hc: i64 = select(body_h < 0, 0, body_h);
    let body: Rect = Rect { origin: Point { column: 0, row: 3 }, size: Size { columns: terminal.columns, rows: body_hc } };
    let status: Rect = Rect { origin: Point { column: 0, row: 3 +% body_hc }, size: Size { columns: terminal.columns, rows: 1 } };
    let nav_w: i64 = select(terminal.columns < 24, select(terminal.columns < 12, terminal.columns, 12), 24);
    let nav_wc: i64 = select(nav_w > body.size.columns, body.size.columns, nav_w);
    let main_w: i64 = body.size.columns -% nav_wc;
    let main_wc: i64 = select(main_w < 0, 0, main_w);
    let nav: Rect = Rect { origin: body.origin, size: Size { columns: nav_wc, rows: body.size.rows } };
    let main_panel: Rect = Rect { origin: Point { column: body.origin.column +% nav_wc, row: body.origin.row }, size: Size { columns: main_wc, rows: body.size.rows } };
    return DemoLayout { window: window, header: header, body: body, nav: nav, main_panel: main_panel, status: status };
}

fn demo_layout_narrow(terminal: Size) -> (result: DemoLayout) {
    return demo_layout(terminal);
}

fn apply_padding(rect: Rect, pad: i64) -> (result: Rect) {
    let insets: Insets = insets_uniform(pad);
    return rect_apply_insets(rect, insets);
}

fn layout_contains_all(demo: DemoLayout) -> (result: bool) {
    let window_ok: bool = rect_contains_rect(demo.window, demo.header) && rect_contains_rect(demo.window, demo.status);
    let body_ok: bool = rect_contains_rect(demo.window, demo.body);
    let nav_ok: bool = rect_contains_rect(demo.body, demo.nav);
    let main_ok: bool = rect_contains_rect(demo.body, demo.main_panel);
    return window_ok && body_ok && nav_ok && main_ok;
}

fn status_height_is_one(demo: DemoLayout) -> (result: bool) {
    return demo.status.size.rows == 1;
}

fn header_height_is_three(demo: DemoLayout) -> (result: bool) {
    return demo.header.size.rows == 3;
}

fn nav_width_bounded(demo: DemoLayout) -> (result: bool) {
    return (demo.nav.size.columns >= 12) && (demo.nav.size.columns <= 40);
}

fn widths_sum(widths: RowWidths) -> (result: i64) {
    return widths.w0 +% widths.w1 +% widths.w2 +% widths.w3;
}

fn heights_sum(heights: ColumnHeights) -> (result: i64) {
    return heights.h0 +% heights.h1 +% heights.h2 +% heights.h3;
}
