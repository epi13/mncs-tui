mncs 0.8;

// TUI events are an adapter boundary. The reusable ANSI parser emits generic
// mncs.std.ansi.v1 events; this module maps those observations into the TUI's
// focus/dispatch vocabulary. Raw scalar normalization remains available for
// hosts that have already decoded a key, but terminal sequence meaning lives
// upstream in the stdlib.
module mncs_tui.events;

use mncs.core.geometry.v1;
use mncs.std.ansi.v1;

enum KeyKind { CHAR, ENTER, BACKSPACE, ESC, ARROW_UP, ARROW_DOWN, ARROW_LEFT, ARROW_RIGHT, TAB, UNKNOWN }
enum Modifier { NONE, SHIFT, CTRL, ALT, CTRL_SHIFT, OTHER }
enum MouseButton { LEFT, RIGHT, MIDDLE, NONE }

record KeyEvent { kind: KeyKind, codepoint: i64, modifiers: Modifier, valid: bool }
record MouseEvent { column: i64, row: i64, button: MouseButton, pressed: bool, valid: bool }
record RawInput { kind: KeyKind, codepoint: i64, modifiers: i64 }

enum Event { Key { key: KeyEvent }, Mouse { mouse: MouseEvent }, Resize { size: Size }, PasteStart, PasteEnd, Paste { length: i64 }, Focus { gained: bool }, Quit, Unknown { raw: i64 } }

fn modifier_from_bits(bits: i64) -> (result: Modifier) {
    if bits == 0 { return Modifier.NONE; }
    if bits == 1 { return Modifier.SHIFT; }
    if bits == 2 { return Modifier.CTRL; }
    if bits == 3 { return Modifier.CTRL_SHIFT; }
    if bits == 4 { return Modifier.ALT; }
    return Modifier.OTHER;
}

fn key_kind_from_raw(raw: i64) -> (result: KeyKind) {
    if raw == 13 { return KeyKind.ENTER; }
    if raw == 27 { return KeyKind.ESC; }
    if raw == 8 { return KeyKind.BACKSPACE; }
    if raw == 9 { return KeyKind.TAB; }
    if raw == 1000 { return KeyKind.ARROW_UP; }
    if raw == 1001 { return KeyKind.ARROW_DOWN; }
    if raw == 1002 { return KeyKind.ARROW_LEFT; }
    if raw == 1003 { return KeyKind.ARROW_RIGHT; }
    if raw >= 32 && raw <= 126 { return KeyKind.CHAR; }
    return KeyKind.UNKNOWN;
}

fn normalize_key(raw: i64, mods: i64) -> (result: KeyEvent) {
    let kind: KeyKind = key_kind_from_raw(raw);
    let valid: bool = match kind {
        UNKNOWN => false,
        CHAR => true,
        ENTER => true,
        BACKSPACE => true,
        ESC => true,
        ARROW_UP => true,
        ARROW_DOWN => true,
        ARROW_LEFT => true,
        ARROW_RIGHT => true,
        TAB => true,
    };
    return KeyEvent { kind: kind, codepoint: select(valid, raw, 0), modifiers: modifier_from_bits(mods), valid: valid };
}

fn key_is_char(event: KeyEvent) -> (result: bool) {
    return match event.kind {
        CHAR => true,
        ENTER => false,
        BACKSPACE => false,
        ESC => false,
        ARROW_UP => false,
        ARROW_DOWN => false,
        ARROW_LEFT => false,
        ARROW_RIGHT => false,
        TAB => false,
        UNKNOWN => false,
    };
}

fn key_is_enter(event: KeyEvent) -> (result: bool) {
    return match event.kind {
        ENTER => true,
        CHAR => false,
        BACKSPACE => false,
        ESC => false,
        ARROW_UP => false,
        ARROW_DOWN => false,
        ARROW_LEFT => false,
        ARROW_RIGHT => false,
        TAB => false,
        UNKNOWN => false,
    };
}

fn key_modifiers(event: KeyEvent) -> (result: Modifier) {
    return event.modifiers;
}

fn key_from_ansi_arrow(direction: i64, modifiers: i64) -> (result: KeyEvent) {
    if direction == 0 { return KeyEvent { kind: KeyKind.ARROW_UP, codepoint: 0, modifiers: modifier_from_bits(modifiers), valid: true }; }
    if direction == 1 { return KeyEvent { kind: KeyKind.ARROW_DOWN, codepoint: 0, modifiers: modifier_from_bits(modifiers), valid: true }; }
    if direction == 2 { return KeyEvent { kind: KeyKind.ARROW_RIGHT, codepoint: 0, modifiers: modifier_from_bits(modifiers), valid: true }; }
    if direction == 3 { return KeyEvent { kind: KeyKind.ARROW_LEFT, codepoint: 0, modifiers: modifier_from_bits(modifiers), valid: true }; }
    return KeyEvent { kind: KeyKind.UNKNOWN, codepoint: 0, modifiers: modifier_from_bits(modifiers), valid: false };
}

fn mouse_button_from_raw(raw: i64) -> (result: MouseButton) {
    if raw == 0 { return MouseButton.LEFT; }
    if raw == 1 { return MouseButton.RIGHT; }
    if raw == 2 { return MouseButton.MIDDLE; }
    return MouseButton.NONE;
}

fn normalize_mouse(column: i64, row: i64, button_raw: i64, pressed_flag: i64) -> (result: MouseEvent) {
    let button: MouseButton = mouse_button_from_raw(button_raw);
    let valid_button: bool = match button {
        LEFT => true,
        RIGHT => true,
        MIDDLE => true,
        NONE => false,
    };
    return MouseEvent { column: column, row: row, button: button, pressed: pressed_flag == 1, valid: column >= 0 && row >= 0 && valid_button };
}

fn mouse_in_rect(mouse: MouseEvent, bounds: Rect) -> (result: bool) {
    return mouse.valid && rect_contains_point(bounds, Point { column: mouse.column, row: mouse.row });
}

fn normalize_resize(columns: i64, rows: i64) -> (result: Event) {
    if columns <= 0 || rows <= 0 { return Event.Unknown { raw: 0 - 1 }; }
    return Event.Resize { size: Size { columns: columns, rows: rows } };
}

fn map_ansi_event(event: AnsiEvent) -> (result: Event) {
    return match event {
        Character { codepoint } => Event.Key { key: normalize_key(codepoint, 0) },
        Escape => Event.Key { key: normalize_key(27, 0) },
        Arrow { direction, modifiers } => Event.Key { key: key_from_ansi_arrow(direction, modifiers) },
        Focus { gained } => Event.Focus { gained: gained },
        PasteStart => Event.PasteStart,
        PasteEnd => Event.PasteEnd,
        Mouse { column, row, button, pressed } => Event.Mouse { mouse: normalize_mouse(column, row, button, select(pressed, 1, 0)) },
        Resize { columns, rows } => normalize_resize(columns, rows),
        Unknown { raw } => Event.Unknown { raw: raw },
    };
}

fn normalize_sequence(length: i64, b0: byte, b1: byte, b2: byte, b3: byte, b4: byte, b5: byte, b6: byte, b7: byte, b8: byte, b9: byte) -> (result: Event) {
    return map_ansi_event(parse_sequence(length, b0, b1, b2, b3, b4, b5, b6, b7, b8, b9));
}

// This is intentionally a pre-decoded host adapter, not a second terminal
// parser. A lone control or unsupported scalar remains Unknown.
fn normalize_raw(raw: RawInput) -> (result: Event) {
    let valid: bool = match raw.kind {
        UNKNOWN => false,
        CHAR => true,
        ENTER => true,
        BACKSPACE => true,
        ESC => true,
        ARROW_UP => true,
        ARROW_DOWN => true,
        ARROW_LEFT => true,
        ARROW_RIGHT => true,
        TAB => true,
    };
    let key: KeyEvent = KeyEvent { kind: raw.kind, codepoint: raw.codepoint, modifiers: modifier_from_bits(raw.modifiers), valid: valid };
    if key.valid { return Event.Key { key: key }; }
    return Event.Unknown { raw: raw.codepoint };
}

fn event_is_quit(event: Event) -> (result: bool) {
    return match event {
        Quit => true,
        Key { key } => false,
        Mouse { mouse } => false,
        Resize { size } => false,
        PasteStart => false,
        PasteEnd => false,
        Paste { length } => false,
        Focus { gained } => false,
        Unknown { raw } => false,
    };
}

fn event_is_unknown(event: Event) -> (result: bool) {
    return match event {
        Unknown { raw } => true,
        Key { key } => false,
        Mouse { mouse } => false,
        Resize { size } => false,
        PasteStart => false,
        PasteEnd => false,
        Paste { length } => false,
        Focus { gained } => false,
        Quit => false,
    };
}

fn event_is_resize(event: Event) -> (result: bool) {
    return match event {
        Resize { size } => true,
        Key { key } => false,
        Mouse { mouse } => false,
        PasteStart => false,
        PasteEnd => false,
        Paste { length } => false,
        Focus { gained } => false,
        Quit => false,
        Unknown { raw } => false,
    };
}

fn event_is_key(event: Event) -> (result: bool) {
    return match event {
        Key { key } => true,
        Mouse { mouse } => false,
        Resize { size } => false,
        PasteStart => false,
        PasteEnd => false,
        Paste { length } => false,
        Focus { gained } => false,
        Quit => false,
        Unknown { raw } => false,
    };
}

fn event_is_mouse(event: Event) -> (result: bool) {
    return match event {
        Mouse { mouse } => true,
        Key { key } => false,
        Resize { size } => false,
        PasteStart => false,
        PasteEnd => false,
        Paste { length } => false,
        Focus { gained } => false,
        Quit => false,
        Unknown { raw } => false,
    };
}

fn event_is_focus(event: Event) -> (result: bool) {
    return match event {
        Focus { gained } => true,
        Key { key } => false,
        Mouse { mouse } => false,
        Resize { size } => false,
        PasteStart => false,
        PasteEnd => false,
        Paste { length } => false,
        Quit => false,
        Unknown { raw } => false,
    };
}

fn event_is_paste_start(event: Event) -> (result: bool) {
    return match event {
        PasteStart => true,
        Key { key } => false,
        Mouse { mouse } => false,
        Resize { size } => false,
        PasteEnd => false,
        Paste { length } => false,
        Focus { gained } => false,
        Quit => false,
        Unknown { raw } => false,
    };
}

fn event_is_paste_end(event: Event) -> (result: bool) {
    return match event {
        PasteEnd => true,
        Key { key } => false,
        Mouse { mouse } => false,
        Resize { size } => false,
        PasteStart => false,
        Paste { length } => false,
        Focus { gained } => false,
        Quit => false,
        Unknown { raw } => false,
    };
}

fn unknown_preserved(raw: RawInput) -> (result: bool) {
    return event_is_unknown(normalize_raw(raw));
}
