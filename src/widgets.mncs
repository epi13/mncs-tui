mncs 0.8;

// Widget composition and bounded state. WidgetTree.root is the real window
// container; every child is clipped by that container before hit-testing.
// Children are stored in deterministic paint/focus order, with fourth being
// the topmost slot.
module mncs_tui.widgets;

use mncs.core.geometry.v1;
use mncs_tui.geometry;
use mncs_tui.render;

enum WidgetKind { CONTAINER, TEXT, LIST, TABLE, PANE, OVERLAY, FORM, STATUS }

record WidgetId { value: i64 }
record Widget { id: WidgetId, kind: WidgetKind, parent: WidgetId, rect: Rect, focusable: bool, visible: bool }
record WidgetTree { root: Widget, first: Widget, second: Widget, third: Widget, fourth: Widget }
record ListState { selected: i64, count: i64, focused: bool }
record TableState { selected_row: i64, rows: i64, cols: i64 }

fn widget_nonnegative(value: i64) -> (result: i64) {
    return select(value < 0, 0, value);
}

fn widget_id_equal(left: WidgetId, right: WidgetId) -> (result: bool) {
    return left.value == right.value;
}

fn kind_equal(left: WidgetKind, right: WidgetKind) -> (result: bool) {
    return match left {
        CONTAINER => match right { CONTAINER => true, TEXT => false, LIST => false, TABLE => false, PANE => false, OVERLAY => false, FORM => false, STATUS => false },
        TEXT => match right { TEXT => true, CONTAINER => false, LIST => false, TABLE => false, PANE => false, OVERLAY => false, FORM => false, STATUS => false },
        LIST => match right { LIST => true, CONTAINER => false, TEXT => false, TABLE => false, PANE => false, OVERLAY => false, FORM => false, STATUS => false },
        TABLE => match right { TABLE => true, CONTAINER => false, TEXT => false, LIST => false, PANE => false, OVERLAY => false, FORM => false, STATUS => false },
        PANE => match right { PANE => true, CONTAINER => false, TEXT => false, LIST => false, TABLE => false, OVERLAY => false, FORM => false, STATUS => false },
        OVERLAY => match right { OVERLAY => true, CONTAINER => false, TEXT => false, LIST => false, TABLE => false, PANE => false, FORM => false, STATUS => false },
        FORM => match right { FORM => true, CONTAINER => false, TEXT => false, LIST => false, TABLE => false, PANE => false, OVERLAY => false, STATUS => false },
        STATUS => match right { STATUS => true, CONTAINER => false, TEXT => false, LIST => false, TABLE => false, PANE => false, OVERLAY => false, FORM => false },
    };
}

fn widget_equal(left: Widget, right: Widget) -> (result: bool) {
    return widget_id_equal(left.id, right.id) && kind_equal(left.kind, right.kind);
}

fn widget_is_container(widget: Widget) -> (result: bool) {
    return match widget.kind {
        CONTAINER => true,
        PANE => true,
        OVERLAY => true,
        TEXT => false,
        LIST => false,
        TABLE => false,
        FORM => false,
        STATUS => false,
    };
}

fn widget_is_focusable(widget: Widget) -> (result: bool) {
    return widget.focusable && widget.visible;
}

fn intrinsic_size(kind: WidgetKind, content_len: i64) -> (result: Size) {
    let length: i64 = widget_nonnegative(content_len);
    return match kind {
        TEXT => Size { columns: length, rows: 1 },
        LIST => Size { columns: 20, rows: length },
        TABLE => Size { columns: 30, rows: length },
        STATUS => Size { columns: length, rows: 1 },
        CONTAINER => Size { columns: 0, rows: 0 },
        PANE => Size { columns: 0, rows: 0 },
        OVERLAY => Size { columns: 0, rows: 0 },
        FORM => Size { columns: 20, rows: 3 },
    };
}

fn widget_intrinsic(widget: Widget, content_len: i64) -> (result: Size) {
    return intrinsic_size(widget.kind, content_len);
}

fn widget_contains_point(widget: Widget, point: Point) -> (result: bool) {
    return widget.visible && rect_contains_point(widget.rect, point);
}

fn widget_intersects(widget: Widget, area: Rect) -> (result: bool) {
    return widget.visible && rect_intersects(widget.rect, area);
}

fn widget_clipped_rect(widget: Widget, parent_clip: Rect) -> (result: Rect) {
    return rect_clip(widget.rect, parent_clip);
}

fn widget_hit_region(widget: Widget, parent_clip: Rect) -> (result: HitRegion) {
    return hit_region_make(widget.id.value, widget.rect, parent_clip);
}

fn child_belongs_to(parent: Widget, child: Widget) -> (result: bool) {
    return child.parent.value == parent.id.value;
}

fn child_contains_point(parent: Widget, child: Widget, point: Point) -> (result: bool) {
    if parent.visible && child.visible && child_belongs_to(parent, child) {
        let region: HitRegion = widget_hit_region(child, parent.rect);
        return hit_contains(region, point);
    }
    return false;
}

fn tree_root(tree: WidgetTree) -> (result: Widget) {
    return tree.root;
}

fn tree_child(tree: WidgetTree, idx: i64) -> (result: Widget) {
    if idx == 0 {
        return tree.first;
    }
    if idx == 1 {
        return tree.second;
    }
    if idx == 2 {
        return tree.third;
    }
    if idx == 3 {
        return tree.fourth;
    }
    return tree.root;
}

// Paint order is first -> second -> third -> fourth. Hit order is the exact
// reverse, so overlays and later siblings deterministically win overlaps.
fn tree_contains(tree: WidgetTree, point: Point) -> (result: i64) {
    if child_contains_point(tree.root, tree.fourth, point) {
        return tree.fourth.id.value;
    }
    if child_contains_point(tree.root, tree.third, point) {
        return tree.third.id.value;
    }
    if child_contains_point(tree.root, tree.second, point) {
        return tree.second.id.value;
    }
    if child_contains_point(tree.root, tree.first, point) {
        return tree.first.id.value;
    }
    if widget_contains_point(tree.root, point) {
        return tree.root.id.value;
    }
    return 0 - 1;
}

fn list_selected(state: ListState) -> (result: i64) {
    return state.selected;
}

fn list_move_down(state: ListState) -> (result: ListState) {
    let count: i64 = widget_nonnegative(state.count);
    let next_index: i64 = state.selected +% 1;
    let last: i64 = count -% 1;
    let clamped: i64 = select(next_index >= count, last, next_index);
    return ListState { selected: select(clamped < 0, 0, clamped), count: count, focused: state.focused };
}

fn list_move_up(state: ListState) -> (result: ListState) {
    let previous: i64 = state.selected -% 1;
    return ListState { selected: select(previous < 0, 0, previous), count: widget_nonnegative(state.count), focused: state.focused };
}

fn list_is_selected(state: ListState, index: i64) -> (result: bool) {
    return state.selected == index;
}

fn table_selected(state: TableState) -> (result: i64) {
    return state.selected_row;
}

fn table_move_down(state: TableState) -> (result: TableState) {
    let rows: i64 = widget_nonnegative(state.rows);
    let next_index: i64 = state.selected_row +% 1;
    let last: i64 = rows -% 1;
    let clamped: i64 = select(next_index >= rows, last, next_index);
    return TableState { selected_row: select(clamped < 0, 0, clamped), rows: rows, cols: widget_nonnegative(state.cols) };
}

fn empty_frame(width: i64, height: i64) -> (result: Frame) {
    let cell: Cell = Cell { column: 0, row: 0, glyph: 0, style: 0 };
    return Frame { width: width, height: height, first: cell, second: cell, third: cell, fourth: cell };
}

fn widget_frame(widget: Widget, glyph: i64) -> (result: Frame) {
    if widget.visible {
        let cell: Cell = Cell { column: widget.rect.origin.column, row: widget.rect.origin.row, glyph: glyph, style: select(widget.focusable, 1, 0) };
        return Frame { width: widget.rect.size.columns, height: widget.rect.size.rows, first: cell, second: Cell { column: 0, row: 0, glyph: 0, style: 0 }, third: Cell { column: 0, row: 0, glyph: 0, style: 0 }, fourth: Cell { column: 0, row: 0, glyph: 0, style: 0 } };
    }
    return empty_frame(widget.rect.size.columns, widget.rect.size.rows);
}

fn status_bar_frame(status: Widget, text_glyph: i64) -> (result: Frame) {
    return widget_frame(status, text_glyph);
}

fn list_frame(item: Widget, selected: bool) -> (result: Frame) {
    let style: i64 = select(selected, 3, 0);
    let cell: Cell = Cell { column: item.rect.origin.column, row: item.rect.origin.row, glyph: 65, style: style };
    return select(item.visible, Frame { width: item.rect.size.columns, height: item.rect.size.rows, first: cell, second: Cell { column: 0, row: 0, glyph: 0, style: 0 }, third: Cell { column: 0, row: 0, glyph: 0, style: 0 }, fourth: Cell { column: 0, row: 0, glyph: 0, style: 0 } }, empty_frame(item.rect.size.columns, item.rect.size.rows));
}

fn invalid_widget_id() -> (result: WidgetId) {
    return WidgetId { value: 0 - 1 };
}

fn first_focusable(tree: WidgetTree) -> (result: WidgetId) {
    if widget_is_focusable(tree.first) {
        return tree.first.id;
    }
    if widget_is_focusable(tree.second) {
        return tree.second.id;
    }
    if widget_is_focusable(tree.third) {
        return tree.third.id;
    }
    if widget_is_focusable(tree.fourth) {
        return tree.fourth.id;
    }
    return invalid_widget_id();
}

fn next_after(current: WidgetId, tree: WidgetTree) -> (result: WidgetId) {
    if widget_id_equal(current, tree.first.id) {
        if widget_is_focusable(tree.second) {
            return tree.second.id;
        }
        if widget_is_focusable(tree.third) {
            return tree.third.id;
        }
        if widget_is_focusable(tree.fourth) {
            return tree.fourth.id;
        }
        return invalid_widget_id();
    }
    if widget_id_equal(current, tree.second.id) {
        if widget_is_focusable(tree.third) {
            return tree.third.id;
        }
        if widget_is_focusable(tree.fourth) {
            return tree.fourth.id;
        }
        return invalid_widget_id();
    }
    if widget_id_equal(current, tree.third.id) {
        if widget_is_focusable(tree.fourth) {
            return tree.fourth.id;
        }
        return invalid_widget_id();
    }
    return invalid_widget_id();
}

fn next_focusable(current: WidgetId, tree: WidgetTree) -> (result: WidgetId) {
    let candidate: WidgetId = next_after(current, tree);
    if candidate.value >= 0 {
        return candidate;
    }
    return first_focusable(tree);
}
