mncs 0.8;

// Terminal projection: lifecycle state plus an explicit, bounded command
// stream. The parser/byte encoder belongs to mncs-language; this module only
// decides which semantic cells must be cleared or written.
module mncs_tui.terminal;

use mncs.core.geometry.v1;
use mncs_tui.render;

enum TerminalOp { CLEAR, CLEAR_CELL, CURSOR_MOVE, CURSOR_HIDE, CURSOR_SHOW, ENTER_ALT, EXIT_ALT, WRITE_CELL, STYLE_SET }

record TerminalCommand { op: TerminalOp, column: i64, row: i64, glyph: i64, style: i64 }
record TerminalState { width: i64, height: i64, alt: bool, cursor_visible: bool, initialized: bool, generation: i64 }
record TerminalCaps { alt_supported: bool, style_supported: bool, width: i64, height: i64 }
record FrameCommands { clear_cmd: TerminalCommand, move_cmd: TerminalCommand, first: TerminalCommand, second: TerminalCommand, third: TerminalCommand, fourth: TerminalCommand, fifth: TerminalCommand, sixth: TerminalCommand, seventh: TerminalCommand, eighth: TerminalCommand, cell_count: i64, command_count: i64, full_redraw: bool }

fn terminal_init(width: i64, height: i64) -> (result: TerminalState) {
    if width <= 0 || height <= 0 {
        return TerminalState { width: 80, height: 24, alt: false, cursor_visible: true, initialized: true, generation: 1 };
    }
    return TerminalState { width: width, height: height, alt: false, cursor_visible: true, initialized: true, generation: 1 };
}

fn terminal_enter_alt(state: TerminalState) -> (result: TerminalState) {
    if state.initialized {
        return TerminalState { width: state.width, height: state.height, alt: true, cursor_visible: state.cursor_visible, initialized: state.initialized, generation: state.generation +% 1 };
    }
    return state;
}

fn terminal_exit_alt(state: TerminalState) -> (result: TerminalState) {
    if state.alt {
        return TerminalState { width: state.width, height: state.height, alt: false, cursor_visible: state.cursor_visible, initialized: state.initialized, generation: state.generation +% 1 };
    }
    return state;
}

fn terminal_set_cursor_visible(state: TerminalState, visible: bool) -> (result: TerminalState) {
    return TerminalState { width: state.width, height: state.height, alt: state.alt, cursor_visible: visible, initialized: state.initialized, generation: state.generation +% 1 };
}

fn terminal_resize(state: TerminalState, new_width: i64, new_height: i64) -> (result: TerminalState) {
    if new_width <= 0 || new_height <= 0 {
        return state;
    }
    return TerminalState { width: new_width, height: new_height, alt: state.alt, cursor_visible: state.cursor_visible, initialized: state.initialized, generation: state.generation +% 1 };
}

fn terminal_cleanup(state: TerminalState) -> (result: TerminalState) {
    if state.initialized {
        return TerminalState { width: state.width, height: state.height, alt: false, cursor_visible: true, initialized: false, generation: state.generation +% 1 };
    }
    return state;
}

fn terminal_is_initialized(state: TerminalState) -> (result: bool) {
    return state.initialized;
}

fn terminal_needs_full_redraw(old_state: TerminalState, new_state: TerminalState) -> (result: bool) {
    return old_state.width != new_state.width || old_state.height != new_state.height || old_state.generation != new_state.generation;
}

fn caps_make(width: i64, height: i64, alt: bool, style: bool) -> (result: TerminalCaps) {
    return TerminalCaps { alt_supported: alt, style_supported: style, width: width, height: height };
}

fn caps_supports_alt(caps: TerminalCaps) -> (result: bool) {
    return caps.alt_supported;
}

fn command_empty() -> (result: TerminalCommand) {
    return TerminalCommand { op: TerminalOp.CLEAR_CELL, column: 0, row: 0, glyph: 0, style: 0 };
}

fn command_clear() -> (result: TerminalCommand) {
    return TerminalCommand { op: TerminalOp.CLEAR, column: 0, row: 0, glyph: 0, style: 0 };
}

fn command_clear_cell(column: i64, row: i64) -> (result: TerminalCommand) {
    return TerminalCommand { op: TerminalOp.CLEAR_CELL, column: column, row: row, glyph: 0, style: 0 };
}

fn command_move(column: i64, row: i64) -> (result: TerminalCommand) {
    return TerminalCommand { op: TerminalOp.CURSOR_MOVE, column: column, row: row, glyph: 0, style: 0 };
}

fn command_write(cell: Cell) -> (result: TerminalCommand) {
    return TerminalCommand { op: TerminalOp.WRITE_CELL, column: cell.column, row: cell.row, glyph: cell.glyph, style: cell.style };
}

fn command_style(style: i64) -> (result: TerminalCommand) {
    return TerminalCommand { op: TerminalOp.STYLE_SET, column: 0, row: 0, glyph: 0, style: style };
}

fn command_is_clear_cell(command: TerminalCommand) -> (result: bool) {
    return match command.op {
        CLEAR_CELL => true,
        CLEAR => false,
        CURSOR_MOVE => false,
        CURSOR_HIDE => false,
        CURSOR_SHOW => false,
        ENTER_ALT => false,
        EXIT_ALT => false,
        WRITE_CELL => false,
        STYLE_SET => false,
    };
}

fn command_is_write(command: TerminalCommand) -> (result: bool) {
    return match command.op {
        WRITE_CELL => true,
        CLEAR_CELL => false,
        CLEAR => false,
        CURSOR_MOVE => false,
        CURSOR_HIDE => false,
        CURSOR_SHOW => false,
        ENTER_ALT => false,
        EXIT_ALT => false,
        STYLE_SET => false,
    };
}

fn bool_not_local(value: bool) -> (result: bool) {
    return select(value, false, true);
}

fn append_command(acc: FrameCommands, command: TerminalCommand, emit: bool) -> (result: FrameCommands) {
    let slot0: bool = emit && acc.cell_count == 0;
    let slot1: bool = emit && acc.cell_count == 1;
    let slot2: bool = emit && acc.cell_count == 2;
    let slot3: bool = emit && acc.cell_count == 3;
    let slot4: bool = emit && acc.cell_count == 4;
    let slot5: bool = emit && acc.cell_count == 5;
    let slot6: bool = emit && acc.cell_count == 6;
    let slot7: bool = emit && acc.cell_count == 7;
    let next_count: i64 = acc.cell_count +% select(emit, 1, 0);
    return FrameCommands { clear_cmd: acc.clear_cmd, move_cmd: acc.move_cmd, first: select(slot0, command, acc.first), second: select(slot1, command, acc.second), third: select(slot2, command, acc.third), fourth: select(slot3, command, acc.fourth), fifth: select(slot4, command, acc.fifth), sixth: select(slot5, command, acc.sixth), seventh: select(slot6, command, acc.seventh), eighth: select(slot7, command, acc.eighth), cell_count: next_count, command_count: acc.command_count, full_redraw: acc.full_redraw };
}

fn project_cell(acc: FrameCommands, old_cell: Cell, new_cell: Cell) -> (result: FrameCommands) {
    let old_present: bool = bool_not_local(cell_is_empty(old_cell));
    let new_present: bool = bool_not_local(cell_is_empty(new_cell));
    let changed: bool = bool_not_local(cell_equal(old_cell, new_cell));
    let moved: bool = old_present && new_present && (old_cell.column != new_cell.column || old_cell.row != new_cell.row);
    let clear_old: bool = changed && old_present && (moved || bool_not_local(new_present));
    let write_new: bool = changed && new_present;
    let after_clear: FrameCommands = append_command(acc, command_clear_cell(old_cell.column, old_cell.row), clear_old);
    return append_command(after_clear, command_write(new_cell), write_new);
}

fn finalize_commands(acc: FrameCommands) -> (result: FrameCommands) {
    let prefix: i64 = select(acc.cell_count > 0, select(acc.full_redraw, 2, 1), 0);
    return FrameCommands { clear_cmd: acc.clear_cmd, move_cmd: acc.move_cmd, first: acc.first, second: acc.second, third: acc.third, fourth: acc.fourth, fifth: acc.fifth, sixth: acc.sixth, seventh: acc.seventh, eighth: acc.eighth, cell_count: acc.cell_count, command_count: prefix +% acc.cell_count, full_redraw: acc.full_redraw };
}

fn initial_commands(clear: bool, column: i64, row: i64, full_redraw: bool) -> (result: FrameCommands) {
    let empty: TerminalCommand = command_empty();
    return FrameCommands { clear_cmd: command_clear(), move_cmd: command_move(column, row), first: empty, second: empty, third: empty, fourth: empty, fifth: empty, sixth: empty, seventh: empty, eighth: empty, cell_count: 0, command_count: select(clear, 1, 0), full_redraw: full_redraw };
}

fn full_redraw_commands(frame: Frame) -> (result: FrameCommands) {
    let start: FrameCommands = initial_commands(true, 0, 0, true);
    let a: FrameCommands = append_command(start, command_write(frame.first), bool_not_local(cell_is_empty(frame.first)));
    let b: FrameCommands = append_command(a, command_write(frame.second), bool_not_local(cell_is_empty(frame.second)));
    let c: FrameCommands = append_command(b, command_write(frame.third), bool_not_local(cell_is_empty(frame.third)));
    let d: FrameCommands = append_command(c, command_write(frame.fourth), bool_not_local(cell_is_empty(frame.fourth)));
    return finalize_commands(d);
}

fn damage_to_commands(old_frame: Frame, new_frame: Frame) -> (result: FrameCommands) {
    let damage: Damage = frame_damage(old_frame, new_frame);
    if damage.full_redraw {
        return full_redraw_commands(new_frame);
    }
    let start: FrameCommands = initial_commands(false, damage.x, damage.y, false);
    let a: FrameCommands = project_cell(start, old_frame.first, new_frame.first);
    let b: FrameCommands = project_cell(a, old_frame.second, new_frame.second);
    let c: FrameCommands = project_cell(b, old_frame.third, new_frame.third);
    let d: FrameCommands = project_cell(c, old_frame.fourth, new_frame.fourth);
    return finalize_commands(d);
}

fn damage_to_commands_legacy(damage: Damage, frame: Frame) -> (result: FrameCommands) {
    let empty: Cell = Cell { column: 0, row: 0, glyph: 0, style: 0 };
    let old_frame: Frame = Frame { width: frame.width, height: frame.height, first: empty, second: empty, third: empty, fourth: empty };
    if damage.full_redraw {
        return full_redraw_commands(frame);
    }
    return damage_to_commands(old_frame, frame);
}

fn frame_to_commands(frame: Frame) -> (result: FrameCommands) {
    return full_redraw_commands(frame);
}

fn commands_count(cmds: FrameCommands) -> (result: i64) {
    return cmds.command_count;
}

fn commands_cell_count(cmds: FrameCommands) -> (result: i64) {
    return cmds.cell_count;
}

fn commands_is_full_redraw(cmds: FrameCommands) -> (result: bool) {
    return cmds.full_redraw;
}

fn terminal_width(state: TerminalState) -> (result: i64) {
    return state.width;
}

fn terminal_height(state: TerminalState) -> (result: i64) {
    return state.height;
}
