mncs 0.8;

module examples.interaction_probe;

use mncs.core.geometry.v1;
use mncs_tui.events;
use mncs_tui.widgets;
use mncs_tui.focus;

fn tree_fixture() -> (result: WidgetTree) {
    let root_id: WidgetId = WidgetId { value: 0 };
    let root: Widget = Widget { id: root_id, kind: WidgetKind.CONTAINER, parent: WidgetId { value: 0 - 1 }, rect: Rect { origin: Point { column: 0, row: 0 }, size: Size { columns: 20, rows: 10 } }, focusable: false, visible: true };
    let header: Widget = Widget { id: WidgetId { value: 1 }, kind: WidgetKind.PANE, parent: root_id, rect: Rect { origin: Point { column: 0, row: 0 }, size: Size { columns: 20, rows: 1 } }, focusable: false, visible: true };
    let nav: Widget = Widget { id: WidgetId { value: 2 }, kind: WidgetKind.LIST, parent: root_id, rect: Rect { origin: Point { column: 0, row: 1 }, size: Size { columns: 5, rows: 8 } }, focusable: true, visible: true };
    let main: Widget = Widget { id: WidgetId { value: 3 }, kind: WidgetKind.PANE, parent: root_id, rect: Rect { origin: Point { column: 5, row: 1 }, size: Size { columns: 15, rows: 8 } }, focusable: true, visible: true };
    let status: Widget = Widget { id: WidgetId { value: 4 }, kind: WidgetKind.STATUS, parent: root_id, rect: Rect { origin: Point { column: 0, row: 9 }, size: Size { columns: 20, rows: 1 } }, focusable: false, visible: true };
    return WidgetTree { root: root, first: header, second: nav, third: main, fourth: status };
}

fn tree_and_focus() -> (result: i64) {
    let tree: WidgetTree = tree_fixture();
    let nav: HitTestResult = hit_test_point(Point { column: 1, row: 2 }, tree);
    let main: HitTestResult = hit_test_point(Point { column: 7, row: 2 }, tree);
    let focus: FocusState = focus_init(tree);
    let next_state: FocusState = focus_move_next(focus, tree);
    return select(nav.hit && nav.hit_id.value == 2 && main.hit_id.value == 3 && focus.current.value == 2 && next_state.current.value == 3, 1, 0);
}

fn ansi_events() -> (result: i64) {
    let arrow: Event = normalize_sequence(3, 27, 91, 65, 0, 0, 0, 0, 0, 0, 0);
    let paste: Event = normalize_sequence(6, 27, 91, 50, 48, 48, 126, 0, 0, 0, 0);
    let resize: Event = normalize_sequence(10, 27, 91, 56, 59, 50, 52, 59, 56, 48, 116);
    return select(event_is_key(arrow) && event_is_paste_start(paste) && event_is_resize(resize), 1, 0);
}
