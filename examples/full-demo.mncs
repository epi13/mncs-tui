mncs 0.8;

// Integrated TUI demo: nested layout, typed geometry, rendering, frame diff,
// focus, keyboard, resize, clipping, and terminal projection in one bounded
// pipeline. This is the vertical slice the architecture promised.
module examples.full_demo;

use mncs.core.geometry.v1;
use mncs_tui.geometry;
use mncs_tui.layout;
use mncs_tui.render;
use mncs_tui.events;
use mncs_tui.widgets;
use mncs_tui.focus;
use mncs_tui.terminal;

fn check_layout(terminal: Size) -> (result: bool) {
    let demo: DemoLayout = demo_layout(terminal);
    return layout_usable(demo);
}

fn layout_usable(demo: DemoLayout) -> (result: bool) {
    let clipped_ok: bool = rect_contains_rect(demo.window, demo.header) && rect_contains_rect(demo.window, demo.body) && rect_contains_rect(demo.window, demo.nav) && rect_contains_rect(demo.window, demo.main_panel) && rect_contains_rect(demo.window, demo.status);
    return select(demo.overflow, clipped_ok, layout_contains_all(demo));
}

fn make_widgets(demo: DemoLayout) -> (result: WidgetTree) {
    let root_widget: Widget = Widget { id: WidgetId { value: 0 }, kind: WidgetKind.CONTAINER, parent: WidgetId { value: 0 - 1 }, rect: demo.window, focusable: false, visible: true };
    let header_widget: Widget = Widget { id: WidgetId { value: 1 }, kind: WidgetKind.PANE, parent: root_widget.id, rect: demo.header, focusable: false, visible: true };
    let nav_widget: Widget = Widget { id: WidgetId { value: 2 }, kind: WidgetKind.LIST, parent: root_widget.id, rect: demo.nav, focusable: true, visible: true };
    let main_widget: Widget = Widget { id: WidgetId { value: 3 }, kind: WidgetKind.PANE, parent: root_widget.id, rect: demo.main_panel, focusable: true, visible: true };
    let status_widget: Widget = Widget { id: WidgetId { value: 4 }, kind: WidgetKind.STATUS, parent: root_widget.id, rect: demo.status, focusable: false, visible: true };
    return WidgetTree { root: root_widget, first: header_widget, second: nav_widget, third: main_widget, fourth: status_widget };
}

fn render_demo(demo: DemoLayout) -> (result: Frame) {
    let tree: WidgetTree = make_widgets(demo);
    let nav_frame: Frame = widget_frame(tree.second, 65);
    return nav_frame;
}

fn diff_demo(old_frame: Frame, new_frame: Frame) -> (result: Damage) {
    return frame_damage(old_frame, new_frame);
}

fn focus_demo(demo: DemoLayout) -> (result: i64) {
    let tree: WidgetTree = make_widgets(demo);
    let focus: FocusState = focus_init(tree);
    let tab_key: KeyEvent = normalize_key(9, 0);
    let tab_event: Event = Event.Key { key: tab_key };
    let dispatched: DispatchResult = dispatch_event(tab_event, focus, tree);
    return dispatched.new_focus.value;
}

fn hit_demo(demo: DemoLayout) -> (result: i64) {
    let tree: WidgetTree = make_widgets(demo);
    let point: Point = Point { column: demo.nav.origin.column +% 1, row: demo.nav.origin.row +% 1 };
    let hit: HitTestResult = hit_test_point(point, tree);
    if hit.hit {
        return hit.hit_id.value;
    }
    return 0 - 1;
}

fn terminal_demo(width: i64, height: i64) -> (result: i64) {
    let state: TerminalState = terminal_init(width, height);
    let alt: TerminalState = terminal_enter_alt(state);
    let resized: TerminalState = terminal_resize(alt, width +% 10, height +% 5);
    let cleaned: TerminalState = terminal_cleanup(resized);
    return cleaned.generation;
}

// Top-level integration: exercises multiple subsystems together and returns
// a deterministic i64 that is 1 when every invariant holds.

fn integrated(columns: i64, rows: i64) -> (result: i64) {
    let terminal: Size = Size { columns: columns, rows: rows };
    let layout_ok: bool = check_layout(terminal);
    let demo: DemoLayout = demo_layout(terminal);
    let tree: WidgetTree = make_widgets(demo);
    let focus_next: i64 = focus_demo(demo);
    let hit_id: i64 = hit_demo(demo);
    let term_gen: i64 = terminal_demo(columns, rows);
    // Frames: old empty frame vs rendered nav.
    let empty_cell: Cell = Cell { column: 0, row: 0, glyph: 0, style: 0 };
    let empty_frame: Frame = Frame { width: columns, height: rows, first: empty_cell, second: empty_cell, third: empty_cell, fourth: empty_cell };
    let nav_frame: Frame = render_demo(demo);
    let damage: Damage = diff_demo(empty_frame, nav_frame);
    let damage_ok: bool = damage.any_changed;
    let projection: FrameCommands = damage_to_commands(empty_frame, nav_frame);
    let projection_ok: bool = commands_count(projection) == 2 && commands_cell_count(projection) == 1;
    let resized_demo: DemoLayout = demo_layout(Size { columns: columns +% 10, rows: rows });
    let resized_ok: bool = layout_usable(resized_demo);
    let a: bool = layout_ok && resized_ok;
    let b: bool = select(a, damage_ok && projection_ok, false);
    let c: bool = select(b, hit_id == 2, false);
    let d: bool = select(c, focus_next == 3, false);
    let all: bool = select(d, term_gen == 4, false);
    return select(all, 1, 0);
}

// Small entry for corpus execution: 80x24, 100x30, 40x10, narrow 20x10.

fn demo_80_24() -> (result: i64) {
    return integrated(80, 24);
}

fn demo_100_30() -> (result: i64) {
    return integrated(100, 30);
}

fn demo_40_10() -> (result: i64) {
    return integrated(40, 10);
}

fn demo_narrow() -> (result: i64) {
    return integrated(20, 10);
}

fn demo_clip() -> (result: bool) {
    let terminal: Size = Size { columns: 80, rows: 24 };
    let demo: DemoLayout = demo_layout(terminal);
    let clip: Rect = Rect { origin: Point { column: 0, row: 0 }, size: Size { columns: 10, rows: 10 } };
    let clipped_nav: Rect = rect_clip(demo.nav, clip);
    return rect_contains_rect(clip, clipped_nav) || rect_is_empty(clipped_nav);
}
